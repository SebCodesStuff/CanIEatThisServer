GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Use 0.0.0.0 in a container so the platform can reach the server
HOST=127.0.0.1
# Set to DEV to turn off rate limiting locally
MODE=DEV
RATE_LIMIT_PER_HOUR=10
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
